<div style="max-width: 900px; margin: 48px auto; font-family: system-ui, sans-serif;">
  <h1>Cache Entries</h1>

  <p style="color: #666;">
    Development-only cache inspector for weather forecast entries.
  </p>

  <% if @entries.empty? %>
    <div style="padding: 16px; border: 1px solid #ddd; border-radius: 8px;">
      No weather forecast cache entries found.
    </div>
  <% else %>
    <% @entries.each do |entry| %>
      <% forecast = entry[:forecast] %>

      <div style="border: 1px solid #ddd; border-radius: 8px; padding: 16px; margin-bottom: 16px;">
        <h2 style="margin-top: 0; font-size: 18px;">
          <%= entry[:key] %>
        </h2>

        <dl style="display: grid; grid-template-columns: 190px 1fr; gap: 8px 16px; margin: 0;">
          <dt><strong>Submitted address</strong></dt>
          <dd><%= forecast.submitted_address %></dd>

          <dt><strong>ZIP code</strong></dt>
          <dd><%= forecast.zip_code %></dd>

          <dt><strong>Current temperature</strong></dt>
          <dd><%= forecast.current_temperature %>°F</dd>

          <dt><strong>High temperature</strong></dt>
          <dd><%= forecast.high_temperature %>°F</dd>

          <dt><strong>Low temperature</strong></dt>
          <dd><%= forecast.low_temperature %>°F</dd>

          <dt><strong>Description</strong></dt>
          <dd><%= forecast.description %></dd>

          <dt><strong>Expires at</strong></dt>
          <dd>
            <% if entry[:expires_at_us].present? %>
              <%= entry[:expires_at_us] %>
            <% else %>
              Not available
            <% end %>
          </dd>

          <dt><strong>Time remaining</strong></dt>
          <dd>
            <% if entry[:expires_at_iso].present? %>
              <span
                data-cache-countdown
                data-expires-at="<%= entry[:expires_at_iso] %>"
                style="font-weight: 700;"
              >
                Calculating...
              </span>
            <% else %>
              Not available
            <% end %>
          </dd>

          <dt><strong>Stored cache flag</strong></dt>
          <dd><%= forecast.from_cache? ? "Pulled from cache" : "Fresh API response" %></dd>
        </dl>
      </div>
    <% end %>
  <% end %>

  <p>
    <%= link_to "Back to forecast", root_path %>
  </p>
</div>

<script>
  function formatRemainingTime(milliseconds) {
    if (milliseconds <= 0) {
      return "Expired";
    }

    const totalSeconds = Math.floor(milliseconds / 1000);
    const minutes = Math.floor(totalSeconds / 60);
    const seconds = totalSeconds % 60;

    return `${minutes}m ${String(seconds).padStart(2, "0")}s`;
  }

  function updateCacheCountdowns() {
    document.querySelectorAll("[data-cache-countdown]").forEach((element) => {
      const expiresAt = new Date(element.dataset.expiresAt);
      const remainingMilliseconds = expiresAt - new Date();

      element.textContent = formatRemainingTime(remainingMilliseconds);

      if (remainingMilliseconds <= 0) {
        element.style.color = "#b00020";
      }
    });
  }

  // The browser updates the visible countdown every second.
  updateCacheCountdowns();
  setInterval(updateCacheCountdowns, 1000);
</script>
